{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ajitha-clinic-api.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://ajitha-clinic-api.onrender.com/media/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}