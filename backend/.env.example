# Copy to backend/.env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=ajitha_clinic
POSTGRES_USER=ajitha
POSTGRES_PASSWORD=replace-with-the-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: upload limits and hero slide cap
HERO_MAX_IMAGES=6
MEDIA_ROOT=
# Set to 1 only when serving over HTTPS in production
SECURE_COOKIES=0
